{
  "apps": {
    "tls": {
      "certificates": {
        "automate": [
          "sub.example.com"
        ]
      }
    },
    "layer4": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "tls"
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "proxy",
                          "upstreams": [
                            {
                              "dial": [
                                "{l4.tls.server_name}:443"
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "tls": {
                            "sni": [
                              "chat.signal.org",
                              "ud-chat.signal.org",
                              "storage.signal.org",
                              "cdn.signal.org",
                              "cdn2.signal.org",
                              "cdn3.signal.org",
                              "cdsi.signal.org",
                              "contentproxy.signal.org",
                              "sfu.voip.signal.org",
                              "svr2.signal.org",
                              "svrb.signal.org",
                              "updates.signal.org",
                              "updates2.signal.org"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}